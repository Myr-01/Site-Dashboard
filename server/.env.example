# Admin şifrəsi (güclü şifrə seç!)
ADMIN_PASSWORD=your_secure_password_here

# Railway avtomatik PORT env var verir — dəyişmə
# PORT=3001

# Railway persistent volume mount path
# Railway dashboard-da Volume yaradıb mount path-i bura yaz
# Məsələn: DATA_DIR=/data
DATA_DIR=/data

# Vercel frontend URL-i (CORS üçün)
# Məsələn: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Node environment
NODE_ENV=production
