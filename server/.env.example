# ⚠ DİQQƏT: Bu fayl şablondur və git-ə commit olunur.
# Buraya HEÇ VAXT real dəyər (hash, secret, şifrə) yazmayın — real dəyərlər
# yalnız `.env` faylına yazılır, o da .gitignore-dadır.

# Admin şifrəsinin bcrypt hash-i (plain şifrə DEYIL!)
# Yaratmaq üçün: cd server && node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# JWT sessiya token-lərini imzalamaq üçün gizli açar (uzun təsadüfi string)
# Yaratmaq üçün: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=random-uzun-string-buraya

# DEPRECATED — artıq istifadə edilmir, ADMIN_PASSWORD_HASH ilə əvəz olundu
# ADMIN_PASSWORD=your_secure_password_here

# Railway avtomatik PORT env var verir — dəyişmə
# PORT=3001

# Railway persistent volume mount path
# Railway dashboard-da Volume yaradıb mount path-i bura yaz
# Məsələn: DATA_DIR=/data
DATA_DIR=/data

# Vercel frontend URL-i (CORS üçün)
# Məsələn: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Brauzer push bildirişləri üçün VAPID açarları (boş buraxılsa push söndürülür)
# Yaratmaq üçün: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sizin-email@numune.com

# Node environment
NODE_ENV=production
